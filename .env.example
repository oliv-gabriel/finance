# Use a pooled PostgreSQL URL for serverless requests when your provider offers one.
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST:5432/DATABASE?sslmode=require"

# Use the direct URL only for schema operations such as migrations and db push.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Required in production. Generate with: npx auth secret
AUTH_SECRET=""
# Public origin only, without /api/auth or a trailing slash.
AUTH_URL="http://localhost:3000"

# Optional: only required by the email synchronization feature.
EMAIL_IMAP_HOST="imap.gmail.com"
EMAIL_USER=""
EMAIL_PASS=""
